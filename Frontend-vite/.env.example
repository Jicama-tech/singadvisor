# Base URL of SingAdvisor's own Backend (NestJS) — auth, landing CMS, and all
# content domains (trainings/consultancy/careers/blog/registrations/...).
VITE_API_URL=http://localhost:4000

# Public base URL of the dedicated eventsh instance. Public event reads
# (listings/detail pages) hit this directly; organizer-scoped operations go
# through the Backend's /eventsh/* proxy, so NO eventsh API key ever ships to
# the browser.
VITE_EVENTSH_PUBLIC_URL=http://localhost:3001

# The single organizer's id on that instance (public config — the id appears
# in the instance's public organizer-scoped URLs, it is not a credential).
VITE_EVENTSH_ORGANIZER_ID=6a813cfd03563020728782a5

# Google Identity Services OAuth Client ID from
# https://console.cloud.google.com/apis/credentials, for THIS app's own
# domain(s). Public value, not a secret. Must match the GOOGLE_CLIENT_ID
# configured on the Backend.
#
# Four features depend on it: blog feedback, training enrolment, buying a
# membership, and opening members-only content. Left unset, the sign-in button
# renders nothing — blog feedback degrades gracefully, but NOBODY can read a
# members-only post or buy a membership, because both are keyed to a verified
# Google address.
#
# The origin serving this SPA must be listed under "Authorized JavaScript
# origins" on that OAuth client — including the local dev origin. A missing one
# fails at sign-in with `Error 400: origin_mismatch`.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Public origin of the live site, no trailing slash. Read at BUILD time, not
# runtime: it is compiled into the bundle as __SITE_URL__ (see vite.config.ts).
# Two things use it — the admin's slug fields, which print it in front of every
# slug so the form shows the real page address, and scripts/generate-sitemap.ts.
# Defaults to https://singadvisor.com when unset.
SITE_URL=https://singadvisor.com
