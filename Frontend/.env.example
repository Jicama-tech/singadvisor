# Database — SQLite for local dev. For Postgres:
#   DATABASE_URL="postgresql://user:password@localhost:5432/singadvisor"
#   (and change provider in prisma/schema.prisma to "postgresql")
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-generated-secret"

# Backend API (Backend/) — admin credential verification now happens here
# instead of via direct Prisma access. See src/lib/auth.ts's authenticate().
# Still used for Landing/Admin/Auth and (until their own cutover)
# Tickets/Sponsors — Events moved to eventsh, see EVENTSH_* below.
BACKEND_URL="http://localhost:4000"

# Same host, but public — used to build <img>/<video> src URLs for files the
# Backend's /uploads/* serves, since the browser fetches those directly and
# needs the real origin, not a server-only env var. Baked in at build time.
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

# eventsh (Phase 4 API-client integration, see events-admin-client.ts /
# events-client.ts) — Events now live there instead of this app's own
# Backend/. Deliberately separate from BACKEND_URL above: this app's own
# Backend still serves Landing/Admin/Auth (and, until their own cutover,
# Tickets/Sponsors), so both remain in play at once during the transition.
# EVENTSH_ORGANIZER_ID / EVENTSH_API_KEY come from eventsh's Super Admin —
# Organizers page → open the organizer → Direct API Access → Generate key.
# This integration is locked to exactly that one Organizer.
EVENTSH_BACKEND_URL="http://localhost:3000"
NEXT_PUBLIC_EVENTSH_URL="http://localhost:3000"
EVENTSH_ORGANIZER_ID="replace-with-the-real-Organizer-_id"
EVENTSH_API_KEY="replace-with-the-generated-key"
# eventsh derives currency from the Organizer's own country rather than
# storing it per-event — since this integration is locked to one Organizer,
# currency is effectively fixed. Set to whatever that Organizer's country
# implies (see organizers.service.ts's CURRENCY_MAP in eventsh).
EVENTSH_DEFAULT_CURRENCY="SGD"

# Seed credentials for the first admin user (used by `npm run db:seed`).
ADMIN_EMAIL="admin@singadvisor.sg"
ADMIN_PASSWORD="ChangeMe123!"

# Public site URL, used for absolute links, metadata, sitemap and robots.
# Include the subpath if the app is served from one.
#   root domain:  https://singadvisor.example.com
#   subpath:      https://jicama.tech/singadvisor
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Serve the app from a subpath. Leave EMPTY to serve from the domain root.
# Baked in at build time — you must rebuild after changing it, not just restart.
#   NEXT_PUBLIC_BASE_PATH="/singadvisor"
NEXT_PUBLIC_BASE_PATH=""
