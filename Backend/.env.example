MONGO_URI="mongodb://127.0.0.1:27017/singadvisor"
JWT_ACCESS_SECRET="REPLACE"
JWT_ACCESS_EXPIRY="8h"
PORT=4000
ADMIN_EMAIL="admin@singadvisor.com"
ADMIN_PASSWORD="ChangeMe123!"

# Link previews (the /share/* Open Graph renderer nginx points social
# crawlers at — see Deployment/nginx-singadvisor.conf).
#   SITE_URL   the public SPA origin. Every og:url and the human redirect
#              are built from it, so a wrong value sends WhatsApp/LinkedIn
#              readers to the wrong host.
#   PUBLIC_URL wherever this service's /uploads/* is publicly reachable —
#              og:image has to be an absolute URL a crawler can fetch. On the
#              same-origin /api proxy that includes the path:
#              PUBLIC_URL="https://singadvisor.com/api"
# Both fall back to localhost: fine in dev, and in production it means every
# preview quietly falls back to the site logo instead of the cover.
SITE_URL="http://localhost:3200"
PUBLIC_URL="http://localhost:4000"

# eventsh (Phase 4 API-client integration) — Events already moved here (see
# Frontend/.env.example); Tickets' final "ticket record creation" step also
# moves here now: Razorpay order-creation + signature verification stay
# exactly as-is in THIS Backend (unchanged, still the only thing that ever
# handles real payment), but once a payment verifies, the resulting ticket
# is created in eventsh instead of this app's own `tickets` collection —
# eventsh becomes the system of record (QR codes, confirmation email/
# WhatsApp, admin views, door-scanning). No API key needed here —
# create-ticket is eventsh's public buyer-purchase endpoint, same
# unauthenticated call a browser would make; this Backend just makes the
# same call server-side once payment is verified.
EVENTSH_BACKEND_URL="http://localhost:3000"
EVENTSH_ORGANIZER_ID="replace-with-the-real-Organizer-_id"
# Organizer API key for eventsh's authenticated routes. Required by the
# /eventsh/* admin forwarder (eventsh-proxy) and by the event mirror's
# reconcile job (events-mirror) — without it the admin cannot save events and
# the mirror falls back to write-through only, logging that it skipped.
EVENTSH_API_KEY="replace-with-the-real-organizer-API-key"

# Blog "Generate with AI" — Qwen via DashScope's OpenAI-compatible endpoint.
# Leave unset to disable the feature (the button surfaces a clear error
# instead of failing silently); the rest of the Blog editor works either way.
QWEN_API_KEY="your-qwen-api-key"
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# Blog reader feedback — readers sign in with Google to leave a rating +
# comment, verified server-side against Google's public keys. Must match
# Frontend-vite's VITE_GOOGLE_CLIENT_ID. Leave unset to disable the feature
# (surfaces a clear error instead of failing silently).
GOOGLE_CLIENT_ID="your-google-oauth-client-id"

# Platform sync — reports this deployment's blog usage stats to jicamaTech's
# central instance registry on a schedule (plus once at boot). Leave any of
# these unset to disable the feature entirely (no-op, no errors).
PLATFORM_REGISTRY_URL="https://registry.example.com"
INSTANCE_ID="replace-with-this-instance-id"
INSTANCE_LICENSE_KEY="replace-with-this-instance-license-key"
